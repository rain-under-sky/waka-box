{
  "name": "waka-box",
  "version": "3.0.0",
  "description": "📊 Update a gist to contain your weekly WakaTime stats",
  "author": "Matan Kushner <hello@matchai.me>",
  "license": "ISC",
  "scripts": {
    "build": "ncc build index.js --out dist --minify --target es2022",
    "test": "node --test",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "@vercel/ncc": "0.38.4",
    "husky": "3.1.0",
    "prettier": "1.19.1",
    "pretty-quick": "2.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
